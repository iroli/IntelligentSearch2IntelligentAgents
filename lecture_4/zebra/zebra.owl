<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/zebra.owl"
         xmlns="http://example.org/zebra.owl#">

<owl:Ontology rdf:about="http://example.org/zebra.owl"/>

<owl:ObjectProperty rdf:about="#живёт_в">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#Человек"/>
  <rdfs:range rdf:resource="#Дом"/>
  <owl:inverseOf rdf:resource="#обитаем"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#имеет">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#Человек"/>
  <rdfs:range rdf:resource="#Животное"/>
  <owl:inverseOf rdf:resource="#принадлежит"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#курит">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#Человек"/>
  <rdfs:range rdf:resource="#Сигареты"/>
  <owl:inverseOf rdf:resource="#курится"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#пьёт">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#Человек"/>
  <rdfs:range rdf:resource="#Напиток"/>
  <owl:inverseOf rdf:resource="#пьётся"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#имеет_цвет">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#Дом"/>
  <rdfs:range rdf:resource="#Цвет"/>
  <owl:inverseOf rdf:resource="#окрашивает"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#находится_справа_от">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#Дом"/>
  <rdfs:range rdf:resource="#Дом"/>
  <owl:inverseOf rdf:resource="#находится_слева_от"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#обитаем">
  <owl:inverseOf rdf:resource="#живёт_в"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#принадлежит">
  <owl:inverseOf rdf:resource="#имеет"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#курится">
  <owl:inverseOf rdf:resource="#курит"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#пьётся">
  <owl:inverseOf rdf:resource="#пьёт"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#окрашивает">
  <owl:inverseOf rdf:resource="#имеет_цвет"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#находится_слева_от">
  <owl:inverseOf rdf:resource="#находится_справа_от"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#Дом">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#дом1"/>
        <rdf:Description rdf:about="#дом2"/>
        <rdf:Description rdf:about="#дом3"/>
        <rdf:Description rdf:about="#дом4"/>
        <rdf:Description rdf:about="#дом5"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Животное">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#зебра"/>
        <rdf:Description rdf:about="#лиса"/>
        <rdf:Description rdf:about="#лошадь"/>
        <rdf:Description rdf:about="#собака"/>
        <rdf:Description rdf:about="#улитки"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Человек">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#англичанин"/>
        <rdf:Description rdf:about="#испанец"/>
        <rdf:Description rdf:about="#норвежец"/>
        <rdf:Description rdf:about="#украинец"/>
        <rdf:Description rdf:about="#японец"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="#живёт_в"/>
          <owl:someValuesFrom rdf:resource="#Дом"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#имеет"/>
          <owl:someValuesFrom rdf:resource="#Животное"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#курит"/>
          <owl:someValuesFrom rdf:resource="#Сигареты"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#пьёт"/>
          <owl:someValuesFrom rdf:resource="#Напиток"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Напиток">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#апельсиновый_сок"/>
        <rdf:Description rdf:about="#вода"/>
        <rdf:Description rdf:about="#кофе"/>
        <rdf:Description rdf:about="#молоко"/>
        <rdf:Description rdf:about="#чай"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Сигареты">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
