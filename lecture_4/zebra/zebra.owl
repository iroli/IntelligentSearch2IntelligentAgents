</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Chesterfield">
  <rdf:type rdf:resource="#Сигареты"/>
  <rdf:type>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#курится"/>
      <owl:someValuesFrom>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#живёт_в"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#находится_справа_от"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#обитаем"/>
                      <owl:someValuesFrom>
                        <owl:Restriction>
                          <owl:onProperty rdf:resource="#имеет"/>
                          <owl:hasValue rdf:resource="#лиса"/>
                        </owl:Restriction>
                      </owl:someValuesFrom>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#находится_слева_от"/>
                  <owl:someValuesFrom>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#обитаем"/>
                      <owl:someValuesFrom>
                        <owl:Restriction>
                          <owl:onProperty rdf:resource="#имеет"/>
                          <owl:hasValue rdf:resource="#лиса"/>
                        </owl:Restriction>
                      </owl:someValuesFrom>
                    </owl:Restriction>
                  </owl:someValuesFrom>
                </owl:Restriction>
              </owl:unionOf>
