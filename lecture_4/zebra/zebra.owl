        <rdf:Description rdf:about="#Kool"/>
        <rdf:Description rdf:about="#LuckyStrike"/>
        <rdf:Description rdf:about="#OldGold"/>
        <rdf:Description rdf:about="#Parliament"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Цвет">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#жёлтый"/>
        <rdf:Description rdf:about="#зелёный"/>
        <rdf:Description rdf:about="#красный"/>
        <rdf:Description rdf:about="#синий"/>
        <rdf:Description rdf:about="#слоновая_кость"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:NamedIndividual rdf:about="#дом1">
  <rdf:type rdf:resource="#Дом"/>
  <rdf:type>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#находится_справа_от"/>
      <owl:allValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Nothing"/>
    </owl:Restriction>
  </rdf:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#дом2">
  <rdf:type rdf:resource="#Дом"/>
  <находится_справа_от rdf:resource="#дом1"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#дом3">
  <rdf:type rdf:resource="#Дом"/>
  <находится_справа_от rdf:resource="#дом2"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#дом4">
  <rdf:type rdf:resource="#Дом"/>
  <находится_справа_от rdf:resource="#дом3"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#дом5">
  <rdf:type rdf:resource="#Дом"/>
  <находится_справа_от rdf:resource="#дом4"/>
  <rdf:type>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#находится_слева_от"/>
      <owl:allValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Nothing"/>
    </owl:Restriction>
  </rdf:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#зебра">
  <rdf:type rdf:resource="#Животное"/>
</owl:NamedIndividual>

