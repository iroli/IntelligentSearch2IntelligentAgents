<owl:NamedIndividual rdf:about="#англичанин">
  <rdf:type rdf:resource="#Человек"/>
  <rdf:type>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#живёт_в"/>
      <owl:someValuesFrom>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#имеет_цвет"/>
          <owl:hasValue rdf:resource="#красный"/>
        </owl:Restriction>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdf:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#испанец">
  <rdf:type rdf:resource="#Человек"/>
