</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#норвежец">
  <rdf:type rdf:resource="#Человек"/>
  <живёт_в rdf:resource="#дом1"/>
  <rdf:type>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#живёт_в"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Restriction>
              <owl:onProperty rdf:resource="#находится_справа_от"/>
              <owl:someValuesFrom>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#имеет_цвет"/>
                  <owl:hasValue rdf:resource="#синий"/>
                </owl:Restriction>
              </owl:someValuesFrom>
            </owl:Restriction>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#находится_слева_от"/>
              <owl:someValuesFrom>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#имеет_цвет"/>
                  <owl:hasValue rdf:resource="#синий"/>
                </owl:Restriction>
              </owl:someValuesFrom>
            </owl:Restriction>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdf:type>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#украинец">
