<owl:Class rdf:about="#Положение">
  <rdfs:subClassOf rdf:resource="#Объект"/>
</owl:Class>

<owl:Class rdf:about="#Рецензия">
  <rdfs:subClassOf rdf:resource="#Объект"/>
  <rdfs:isDefinedBy rdf:resource="#T06"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#на_статью"/>
      <owl:someValuesFrom rdf:resource="#Статья"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#рецензент"/>
      <owl:someValuesFrom rdf:resource="#Рецензент"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Статья">
  <rdfs:subClassOf rdf:resource="#Объект"/>
</owl:Class>

<owl:Class rdf:about="#Рецензент">
  <rdfs:subClassOf rdf:resource="#Объект"/>
</owl:Class>

<owl:Class rdf:about="#Организация">
  <rdfs:subClassOf rdf:resource="#Объект"/>
</owl:Class>

<owl:Class rdf:about="#Требование">
  <rdfs:subClassOf rdf:resource="#Положение"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#зависит_от"/>
      <owl:someValuesFrom rdf:resource="#Раздел"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Утверждение">
  <rdfs:subClassOf rdf:resource="#Объект"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#доказывается"/>
      <owl:someValuesFrom rdf:resource="#Доказательство"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Доказательство">
  <rdfs:subClassOf rdf:resource="#Объект"/>
</owl:Class>

<owl:Class rdf:about="#Объект">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Раздел">
  <rdfs:subClassOf rdf:resource="#Положение"/>
</owl:Class>

<owl:Class rdf:about="#Термин">
  <rdfs:subClassOf rdf:resource="#Положение"/>
</owl:Class>

<owl:Class rdf:about="#БазовоеПоложение">
  <rdfs:subClassOf rdf:resource="#Положение"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Положение"/>
        <owl:Class>
          <owl:complementOf>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#зависит_от"/>
              <owl:someValuesFrom rdf:resource="#Положение"/>
            </owl:Restriction>
          </owl:complementOf>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#СданнаяРецензия">
  <rdfs:subClassOf rdf:resource="#Рецензия"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Рецензия"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#сдано"/>
          <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ГотоваяКРешениюСтатья">
  <rdfs:subClassOf rdf:resource="#Статья"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Статья"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#имеет_рецензию"/>
          <owl:onClass rdf:resource="#СданнаяРецензия"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#имеет_рецензию"/>
          <owl:allValuesFrom>
            <owl:Class>
              <owl:intersectionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#Рецензия"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#ответ_авторов"/>
                  <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
                </owl:Restriction>
              </owl:intersectionOf>
            </owl:Class>
          </owl:allValuesFrom>
        </owl:Restriction>
        <owl:Class>
          <owl:complementOf>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#нарушает"/>
              <owl:someValuesFrom rdf:resource="#Требование"/>
            </owl:Restriction>
          </owl:complementOf>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

