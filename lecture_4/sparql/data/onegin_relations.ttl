@prefix : <http://example.org/onegin#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Второстепенный a rdfs:Class ;
    rdfs:label "второстепенный персонаж"@ru ;
    rdfs:subClassOf :Персонаж .

:ГлавныйГерой a rdfs:Class ;
    rdfs:label "главный герой"@ru ;
    rdfs:subClassOf :Персонаж .

:Место a rdfs:Class ;
    rdfs:label "место"@ru .

:Объяснение a rdfs:Class ;
    rdfs:label "объяснение"@ru ;
    rdfs:subClassOf :Событие .

:Персонаж a rdfs:Class ;
    rdfs:label "персонаж"@ru .

:Письмо a rdfs:Class ;
    rdfs:label "письмо"@ru ;
    rdfs:subClassOf :Событие .

:Праздник a rdfs:Class ;
    rdfs:label "праздник"@ru ;
    rdfs:subClassOf :Событие .

:Событие a rdfs:Class ;
    rdfs:label "событие"@ru .

:Автор a :Второстепенный ;
    rdfs:label "автор, рассказчик"@ru ;
    :друг :Онегин ;
    skos:altLabel "автор"@ru .

:автор a rdf:Property ;
    rdfs:label "автор"@ru .

:адресат a rdf:Property ;
    rdfs:label "адресат"@ru .

:вСтрофах a rdf:Property ;
    rdfs:label "рассказано в строфе"@ru .

:глава a rdf:Property ;
    rdfs:label "глава"@ru .

:друг a rdf:Property ;
    rdfs:label "друг"@ru .

:дядя a rdf:Property ;
    rdfs:label "дядя"@ru .

:жених a rdf:Property ;
    rdfs:label "жених"@ru ;
    rdfs:subPropertyOf :родня .

:живёт a rdf:Property ;
    rdfs:label "живёт в"@ru .

:мать a rdf:Property ;
    rdfs:label "мать"@ru ;
    rdfs:subPropertyOf :родня .

:место a rdf:Property ;
    rdfs:label "место"@ru .

:муж a rdf:Property ;
    rdfs:label "муж"@ru ;
    rdfs:subPropertyOf :родня .

:няня a rdf:Property ;
    rdfs:label "няня"@ru .

:ответНа a rdf:Property ;
    rdfs:label "ответ на"@ru .

:привелоК a rdf:Property ;
    rdfs:label "привело к"@ru .

:секундант a rdf:Property ;
    rdfs:label "секундант у"@ru .

:сестра a rdf:Property ;
    rdfs:label "сестра"@ru ;
    rdfs:subPropertyOf :родня .

:следует a rdf:Property ;
    rdfs:label "следует за"@ru .

:слуга a rdf:Property ;
    rdfs:label "слуга у"@ru .

:участник a rdf:Property ;
    rdfs:label "участник"@ru .

:Гильо a :Второстепенный ;
    rdfs:label "Гильо, слуга Онегина"@ru ;
    :секундант :Онегин ;
    :слуга :Онегин ;
    skos:altLabel "Гильо"@ru .

:Дядя a :Второстепенный ;
    rdfs:label "дядя Онегина"@ru ;
    skos:altLabel "дядя"@ru .

:Москва a :Место ;
    rdfs:label "Москва"@ru .

:Филипьевна a :Второстепенный ;
    rdfs:label "Филипьевна, няня Татьяны"@ru ;
    skos:altLabel "Филипьевна"@ru,
        "няня"@ru .

:встреча_в_Петербурге a :Праздник ;
    rdfs:label "встреча Онегина и Татьяны в Петербурге"@ru ;
    :вСтрофах :строфа_8_XVII,
        :строфа_8_XVIII ;
    :глава 8 ;
    :место :Петербург ;
    :привелоК :письмо_Онегина ;
    :следует :приезд_в_Москву ;
    :участник :Князь,
        :Онегин,
        :Татьяна .

:именины a :Праздник ;
    rdfs:label "именины Татьяны"@ru ;
    :вСтрофах :строфа_5_XXV ;
    :глава 5 ;
    :место :Деревня ;
    :привелоК :ссора_на_балу ;
    :следует :сон_Татьяны ;
    :участник :Ларина,
        :Ленский,
        :Ольга,
        :Онегин,
        :Татьяна .

:последнее_объяснение a :Объяснение ;
    rdfs:label "последнее объяснение Татьяны"@ru ;
    :вСтрофах :строфа_8_XLII,
        :строфа_8_XLIII,
        :строфа_8_XLIV,
        :строфа_8_XLV,
        :строфа_8_XLVI,
        :строфа_8_XLVII,
        :строфа_8_XLVIII ;
    :глава 8 ;
    :место :Петербург ;
    :ответНа :письмо_Онегина ;
    :следует :письмо_Онегина ;
    :участник :Онегин,
        :Татьяна .

:приезд_в_Москву a :Событие ;
    rdfs:label "приезд Татьяны в Москву"@ru ;
    :вСтрофах :строфа_7_XXXVI,
        :строфа_7_XXXVII,
        :строфа_7_XXXVIII ;
    :глава 7 ;
    :место :Москва ;
    :следует :гибель_Ленского ;
    :участник :Ларина,
        :Татьяна .

:сон_Татьяны a :Событие ;
    rdfs:label "сон Татьяны"@ru ;
    :вСтрофах :строфа_5_XI,
        :строфа_5_XII,
        :строфа_5_XIII,
        :строфа_5_XIV,
        :строфа_5_XV ;
    :глава 5 ;
    :место :Деревня ;
    :следует :объяснение_в_саду ;
    :участник :Татьяна .

:Зарецкий a :Второстепенный ;
    rdfs:label "Зарецкий"@ru ;
    :секундант :Ленский .

:Князь a :Второстепенный ;
    rdfs:label "князь, муж Татьяны"@ru ;
    skos:altLabel "князь"@ru .

:вызов a :Письмо ;
    rdfs:label "вызов на дуэль"@ru ;
    :автор :Ленский ;
    :адресат :Онегин ;
    :вСтрофах :строфа_6_IX ;
    :глава 6 ;
    :место :Деревня ;
    :привелоК :дуэль ;
    :следует :ссора_на_балу ;
    :участник :Зарецкий,
        :Ленский,
        :Онегин .

:гибель_Ленского a :Событие ;
    rdfs:label "гибель Ленского"@ru ;
    :вСтрофах :строфа_6_XXXI,
        :строфа_6_XXXII ;
    :глава 6 ;
    :место :Деревня ;
    :следует :дуэль ;
    :участник :Ленский .

:дуэль a :Событие ;
    rdfs:label "дуэль Онегина и Ленского"@ru ;
    :вСтрофах :строфа_6_XXIX,
        :строфа_6_XXX,
        :строфа_6_XXXI,
        :строфа_6_XXXII ;
    :глава 6 ;
    :место :Деревня ;
    :привелоК :гибель_Ленского ;
    :следует :вызов ;
    :участник :Гильо,
        :Зарецкий,
        :Ленский,
        :Онегин .

:объяснение_в_саду a :Объяснение ;
    rdfs:label "ответ Онегина в саду"@ru ;
    :вСтрофах :строфа_4_XII,
        :строфа_4_XIII,
        :строфа_4_XIV,
        :строфа_4_XV,
        :строфа_4_XVI ;
    :глава 4 ;
    :место :Деревня ;
    :ответНа :письмо_Татьяны ;
    :следует :письмо_Татьяны ;
    :участник :Онегин,
        :Татьяна .

:письмо_Татьяны a :Письмо ;
    rdfs:label "письмо Татьяны к Онегину"@ru ;
    :автор :Татьяна ;
    :адресат :Онегин ;
    :вСтрофах :строфа_3_XXXI,
        :строфа_3_ПТ ;
    :глава 3 ;
    :место :Деревня ;
    :привелоК :объяснение_в_саду ;
    :участник :Онегин,
        :Татьяна .

:ссора_на_балу a :Событие ;
    rdfs:label "Онегин танцует с Ольгой"@ru ;
    :вСтрофах :строфа_5_XLI,
        :строфа_5_XLII,
        :строфа_5_XLIII,
        :строфа_5_XLIV,
        :строфа_5_XLV ;
    :глава 5 ;
    :место :Деревня ;
    :привелоК :вызов ;
    :следует :именины ;
    :участник :Ленский,
        :Ольга,
        :Онегин .

:письмо_Онегина a :Письмо ;
    rdfs:label "письмо Онегина к Татьяне"@ru ;
    :автор :Онегин ;
    :адресат :Татьяна ;
    :вСтрофах :строфа_8_ПО ;
    :глава 8 ;
    :место :Петербург ;
    :привелоК :последнее_объяснение ;
    :следует :встреча_в_Петербурге ;
    :участник :Онегин,
        :Татьяна .

:Ларина a :Второстепенный ;
    rdfs:label "Ларина, мать Татьяны и Ольги"@ru ;
    skos:altLabel "Ларина"@ru,
        "старушка Ларина"@ru .

:Ольга a :ГлавныйГерой ;
    rdfs:label "Ольга Ларина"@ru ;
    :мать :Ларина ;
    :сестра :Татьяна ;
    skos:altLabel "Ольга"@ru .

:родня a rdf:Property ;
    rdfs:label "родня"@ru .

:Петербург a :Место ;
    rdfs:label "Петербург"@ru .

:Ленский a :ГлавныйГерой ;
    rdfs:label "Владимир Ленский"@ru ;
    :друг :Онегин ;
    :жених :Ольга ;
    :живёт :Деревня ;
    skos:altLabel "Владимир"@ru,
        "Ленский"@ru .

:Деревня a :Место ;
    rdfs:label "деревня, усадьбы Лариных и Онегина"@ru .

:Татьяна a :ГлавныйГерой ;
    rdfs:label "Татьяна Ларина"@ru ;
    :живёт :Деревня,
        :Петербург ;
    :мать :Ларина ;
    :муж :Князь ;
    :няня :Филипьевна ;
    :сестра :Ольга ;
    skos:altLabel "Таня"@ru,
        "Татьяна"@ru .

:Онегин a :ГлавныйГерой ;
    rdfs:label "Евгений Онегин"@ru ;
    :друг :Ленский ;
    :дядя :Дядя ;
    :живёт :Деревня,
        :Петербург ;
    skos:altLabel "Евгений"@ru,
        "Онегин"@ru .

