<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://w3id.org/cluedo4KG/onto"
         xmlns="https://w3id.org/cluedo4KG/onto#">

<owl:Ontology rdf:about="https://w3id.org/cluedo4KG/onto"/>

<owl:ObjectProperty rdf:about="#isLocatedIn">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Place"/>
  <rdfs:range rdf:resource="#Place"/>
  <owl:inverseOf rdf:resource="#contains"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contains">
  <owl:inverseOf rdf:resource="#isLocatedIn"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#roomInHouse">
  <rdfs:subPropertyOf rdf:resource="#isLocatedIn"/>
  <rdfs:domain rdf:resource="#Room"/>
  <rdfs:range rdf:resource="#House"/>
  <owl:inverseOf rdf:resource="#houseContainsRoom"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#houseContainsRoom">
  <owl:inverseOf rdf:resource="#roomInHouse"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#roomOnFloor">
  <rdfs:subPropertyOf rdf:resource="#isLocatedIn"/>
  <rdfs:domain rdf:resource="#Room"/>
  <rdfs:range rdf:resource="#Floor"/>
  <owl:inverseOf rdf:resource="#floorContainsRoom"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#floorContainsRoom">
  <owl:inverseOf rdf:resource="#roomOnFloor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#floorInHouse">
  <rdfs:subPropertyOf rdf:resource="#isLocatedIn"/>
  <rdfs:domain rdf:resource="#Floor"/>
  <rdfs:range rdf:resource="#House"/>
  <owl:inverseOf rdf:resource="#houseContainsFloor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#houseContainsFloor">
  <owl:inverseOf rdf:resource="#floorInHouse"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#areaInRoom">
  <rdfs:subPropertyOf rdf:resource="#isLocatedIn"/>
  <rdfs:domain rdf:resource="#Area"/>
  <rdfs:range rdf:resource="#Room"/>
  <owl:inverseOf rdf:resource="#roomContainsArea"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#roomContainsArea">
  <owl:inverseOf rdf:resource="#areaInRoom"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#roomContainsObject"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#isCentreOf"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAsNeighbourRoom">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
  <rdfs:domain rdf:resource="#Room"/>
  <rdfs:range rdf:resource="#Room"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#organisedAround">
  <rdfs:domain rdf:resource="#Area"/>
  <rdfs:range rdf:resource="#ImmobileObject"/>
  <owl:inverseOf rdf:resource="#isCentreOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isCentreOf">
  <owl:inverseOf rdf:resource="#organisedAround"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCauseOfDeath">
  <rdfs:domain rdf:resource="#Victim"/>
  <rdfs:range rdf:resource="#CauseOfDeath"/>
  <owl:inverseOf rdf:resource="#causeOf"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#causeOf">
  <owl:inverseOf rdf:resource="#hasCauseOfDeath"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dueTo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#CauseOfDeath"/>
  <rdfs:range rdf:resource="#MobileObject"/>
  <owl:inverseOf rdf:resource="#responsibleFor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#responsibleFor">
  <owl:inverseOf rdf:resource="#dueTo"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ownsOrOwned">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Object"/>
  <owl:inverseOf rdf:resource="#ownedBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#owns">
  <rdfs:subPropertyOf rdf:resource="#ownsOrOwned"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ownedBy">
  <owl:inverseOf rdf:resource="#ownsOrOwned"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#killedBy">
  <rdfs:domain rdf:resource="#Victim"/>
  <rdfs:range rdf:resource="#Murderer"/>
  <owl:inverseOf rdf:resource="#killed"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#killed">
  <owl:inverseOf rdf:resource="#killedBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isOrWasInPlace">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Place"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#isOrWasInPlace"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#isLocatedIn"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isInPlace">
  <rdfs:subPropertyOf rdf:resource="#isOrWasInPlace"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#owns"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#objectInRoom"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#personInRoom">
  <rdfs:subPropertyOf rdf:resource="#isInPlace"/>
  <rdfs:range rdf:resource="#Room"/>
  <owl:inverseOf rdf:resource="#roomContainsPerson"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#roomContainsPerson">
  <owl:inverseOf rdf:resource="#personInRoom"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#objectInRoom">
  <rdfs:domain rdf:resource="#Object"/>
  <rdfs:range rdf:resource="#Room"/>
  <owl:inverseOf rdf:resource="#roomContainsObject"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#roomContainsObject">
  <owl:inverseOf rdf:resource="#objectInRoom"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasDensity">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#discoveredAfter">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#isAlive">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Object">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#MobileObject">
  <rdfs:subClassOf rdf:resource="#Object"/>
  <owl:disjointWith rdf:resource="#ImmobileObject"/>
</owl:Class>

<owl:Class rdf:about="#ImmobileObject">
  <rdfs:subClassOf rdf:resource="#Object"/>
</owl:Class>

<owl:Class rdf:about="#BluntObject">
  <rdfs:subClassOf rdf:resource="#MobileObject"/>
</owl:Class>

<owl:Class rdf:about="#SharpObject">
  <rdfs:subClassOf rdf:resource="#MobileObject"/>
</owl:Class>

<owl:Class rdf:about="#SoftObject">
  <rdfs:subClassOf rdf:resource="#MobileObject"/>
</owl:Class>

<owl:Class rdf:about="#Firearm">
  <rdfs:subClassOf rdf:resource="#MobileObject"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#http://www.lamaisondumeurtre.fr/BC#Revolver_Python_357"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Product">
  <rdfs:subClassOf rdf:resource="#MobileObject"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#LiquidProduct"/>
        <rdf:Description rdf:about="#PowderProduct"/>
      </owl:unionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Weapon">
  <rdfs:subClassOf rdf:resource="#MobileObject"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#BluntObject"/>
        <rdf:Description rdf:about="#SharpObject"/>
        <rdf:Description rdf:about="#Firearm"/>
      </owl:unionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#LiquidProduct">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <owl:disjointWith rdf:resource="#PowderProduct"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Product"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasDensity"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.5</xsd:maxExclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#PowderProduct">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Product"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasDensity"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.5</xsd:minExclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Person">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Victim"/>
        <rdf:Description rdf:about="#Murderer"/>
        <rdf:Description rdf:about="#Innocent"/>
      </owl:unionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Victim">
  <rdfs:subClassOf rdf:resource="#Person"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Person"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#isAlive"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCauseOfDeath"/>
      <owl:onClass rdf:resource="#CauseOfDeath"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Murderer">
  <rdfs:subClassOf rdf:resource="#Person"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Person"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#killed"/>
          <owl:someValuesFrom rdf:resource="#Person"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Person"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#ownsOrOwned"/>
          <owl:someValuesFrom>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#responsibleFor"/>
              <owl:someValuesFrom>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#causeOf"/>
                  <owl:someValuesFrom rdf:resource="#Victim"/>
                </owl:Restriction>
              </owl:someValuesFrom>
            </owl:Restriction>
          </owl:someValuesFrom>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#isOrWasInPlace"/>
          <owl:someValuesFrom rdf:resource="#CrimeScene"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">killer</rdfs:label>
  <rdfs:label xml:lang="fr">meurtrier</rdfs:label>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assassin</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Innocent">
  <rdfs:subClassOf rdf:resource="#Person"/>
</owl:Class>

<owl:Class rdf:about="#Place">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#House">
  <rdfs:subClassOf rdf:resource="#Place"/>
  <owl:disjointWith rdf:resource="#Floor"/>
</owl:Class>

<owl:Class rdf:about="#Room">
  <rdfs:subClassOf rdf:resource="#Place"/>
</owl:Class>

<owl:Class rdf:about="#Floor">
  <rdfs:subClassOf rdf:resource="#Place"/>
  <owl:disjointWith rdf:resource="#Room"/>
</owl:Class>

<owl:Class rdf:about="#Area">
  <rdfs:subClassOf rdf:resource="#Place"/>
</owl:Class>

<owl:Class rdf:about="#CauseOfDeath">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:oneOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#theCause"/>
      </owl:oneOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Injury">
  <rdfs:subClassOf rdf:resource="#CauseOfDeath"/>
</owl:Class>

<owl:Class rdf:about="#Drowning">
  <rdfs:subClassOf rdf:resource="#CauseOfDeath"/>
</owl:Class>

<owl:Class rdf:about="#Poisoning">
  <rdfs:subClassOf rdf:resource="#CauseOfDeath"/>
</owl:Class>

<owl:Class rdf:about="#GunshotInjury">
  <rdfs:subClassOf rdf:resource="#Injury"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#dueTo"/>
      <owl:someValuesFrom rdf:resource="#Firearm"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#SharpInjury">
  <rdfs:subClassOf rdf:resource="#Injury"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#dueTo"/>
      <owl:someValuesFrom rdf:resource="#SharpObject"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#BluntInjury">
  <rdfs:subClassOf rdf:resource="#Injury"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#dueTo"/>
      <owl:someValuesFrom rdf:resource="#BluntObject"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#CrimeScene">
  <rdfs:subClassOf rdf:resource="#Room"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Room"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#roomContainsPerson"/>
          <owl:someValuesFrom rdf:resource="#Victim"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ShotVictim">
  <rdfs:subClassOf rdf:resource="#Victim"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Victim"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#discoveredAfter"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</xsd:maxExclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCauseOfDeath"/>
      <owl:someValuesFrom rdf:resource="#GunshotInjury"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#OtherVictim">
  <rdfs:subClassOf rdf:resource="#Victim"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Victim"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#discoveredAfter"/>
          <owl:someValuesFrom>
            <rdfs:Datatype>
              <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
              <owl:withRestrictions>
                <rdf:Description>
                  <rdf:first>
                    <rdf:Description>
                      <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</xsd:minInclusive>
                    </rdf:Description>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </owl:withRestrictions>
            </rdfs:Datatype>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCauseOfDeath"/>
      <owl:allValuesFrom>
        <owl:Class>
          <owl:complementOf rdf:resource="#GunshotInjury"/>
        </owl:Class>
      </owl:allValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:NamedIndividual rdf:about="#theCause">
  <rdf:type rdf:resource="#CauseOfDeath"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#http://www.lamaisondumeurtre.fr/BC#Revolver_Python_357">
  <rdf:type rdf:resource="#Firearm"/>
</owl:NamedIndividual>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Victim"/>
    <rdf:Description rdf:about="#Murderer"/>
    <rdf:Description rdf:about="#Innocent"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Injury"/>
    <rdf:Description rdf:about="#Drowning"/>
    <rdf:Description rdf:about="#Poisoning"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Object"/>
    <rdf:Description rdf:about="#Person"/>
    <rdf:Description rdf:about="#Place"/>
    <rdf:Description rdf:about="#CauseOfDeath"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#BluntObject"/>
    <rdf:Description rdf:about="#SharpObject"/>
    <rdf:Description rdf:about="#SoftObject"/>
    <rdf:Description rdf:about="#Firearm"/>
    <rdf:Description rdf:about="#Product"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
