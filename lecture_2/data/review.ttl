:Утверждение a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :доказывается ;
            owl:someValuesFrom :Доказательство ],
        :Объект .

:Доказательство a owl:Class ;
    rdfs:subClassOf :Объект .

:Объект a owl:Class ;
    rdfs:subClassOf owl:Thing .

:Организация a owl:Class ;
    rdfs:subClassOf :Объект .

:Раздел a owl:Class ;
    rdfs:subClassOf :Положение .

:Положение a owl:Class ;
    rdfs:subClassOf :Объект .

:Рецензент a owl:Class ;
    rdfs:subClassOf :Объект .

:Термин a owl:Class ;
    rdfs:subClassOf :Положение .

:S03 a :Раздел,
        owl:NamedIndividual ;
    rdfs:label "Раздел 3. Термины и определения"@ru ;
    :зависит_от :S01 ;
    :источник "Положение о статьях §3"^^xsd:string .

:Статья a owl:Class ;
    rdfs:subClassOf :Объект .

:Требование a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :зависит_от ;
            owl:someValuesFrom :Раздел ],
        :Положение .

:Рецензия a owl:Class ;
    rdfs:isDefinedBy :T06 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :на_статью ;
            owl:someValuesFrom :Статья ],
        [ a owl:Restriction ;
            owl:onProperty :рецензент ;
            owl:someValuesFrom :Рецензент ],
        :Объект .

[] a owl:AllDisjointClasses ;
    owl:members ( :Раздел :Термин :Требование ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Положение :Статья :Рецензия :Рецензент :Организация :Утверждение :Доказательство ) .

[] a swrl:Imp ;
    swrl:body ( [ a swrl:ClassAtom ;
                swrl:argument1 <urn:swrl#r> ;
                swrl:classPredicate :Рецензия ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#r> ;
                swrl:argument2 <urn:swrl#s> ;
                swrl:propertyPredicate :на_статью ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#r> ;
                swrl:argument2 <urn:swrl#p> ;
                swrl:propertyPredicate :рецензент ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#p> ;
                swrl:argument2 <urn:swrl#o> ;
                swrl:propertyPredicate :из_организации ] [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#s> ;
                swrl:argument2 <urn:swrl#o> ;
                swrl:propertyPredicate :организация_авторов ] ) ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                swrl:argument1 <urn:swrl#s> ;
                swrl:argument2 :R62 ;
                swrl:propertyPredicate :нарушает ] ) .

