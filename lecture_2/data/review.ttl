:БазовоеПоложение a owl:Class ;
    rdfs:subClassOf :Положение ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :Положение [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty :зависит_от ;
                                owl:someValuesFrom :Положение ] ] ) ] .

